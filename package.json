{
  "allSites": {
    "excludedHeaders": [],
    "requestHeaders": {
      "User-Agent": "Mozilla/5.0 (Windows NT 6.1; WOW64; rv:30.0) Gecko/20100101 Firefox/30.0"
    }
  },
  "author": "Guy Ellis <wildfiction@gmail.com> (http://www.guyellisrocks.com/)",
  "bugs": {
    "url": "https://github.com/guyellis/http-status-check/issues"
  },
  "concurrentRequests": 10,
  "dependencies": {
    "async": "3.2.6",
    "debug": "4.4.3",
    "lodash": "4.18.1",
    "nodemailer": "10.1.4"
  },
  "description": "Utility to check the HTTP status of URL endpoints",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/async": "3.2.26",
    "@types/debug": "4.1.13",
    "@types/lodash": "4.17.26",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.13.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/guyellis/http-status-check",
  "inAdapter": {
    "type": "./lib/inAdapters/fileAdapter"
  },
  "keywords": [
    "http",
    "status",
    "checker"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "type": "module",
  "name": "http-status-check",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guyellis/http-status-check.git"
  },
  "scripts": {
    "build": "vite build",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lintfix": "eslint . --fix",
    "post-commit-stash-pop": "git stash pop",
    "pre-commit-stash-save": "git stash --keep-index",
    "start": "node dist/index.js",
    "test": "tsc --noEmit && vitest run && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "version": "1.1.0"
}
